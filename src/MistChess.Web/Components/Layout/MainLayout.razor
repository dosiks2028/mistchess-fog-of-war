@inherits LayoutComponentBase

<div class="site-shell">
    <header class="site-header">
        <a class="brand" href="/" aria-label="MistChess home">
            <span class="brand-mark">M<span>♞</span></span>
            <span class="brand-name">MIST<span>CHESS</span></span>
        </a>
        <NavMenu />
        <a class="header-cta" href="/">Play <span>↗</span></a>
    </header>
    <main class="site-main">@Body</main>
    <footer class="site-footer">
        <span>MistChess · Fog of War chess</span>
        <span>Built with C# and .NET 8</span>
    </footer>
</div>

<div id="blazor-error-ui">
    <span>A connection error occurred. Please reload the page.</span>
    <a href="" class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">×</button>
</div>
