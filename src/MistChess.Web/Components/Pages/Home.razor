@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject GameSessionStore Session

<PageTitle>MistChess — Fog of War Chess</PageTitle>

<div class="game-page">
    <section class="hero-row">
        <div>
            <p class="eyebrow">CHESS WITH INCOMPLETE INFORMATION</p>
            <h1>Think beyond the visible.</h1>
            <p class="hero-copy">In the fog, you can see your pieces, the squares they control, and traces of your opponent's latest move.</p>
        </div>
        <div class="hero-stat"><span class="stat-dot"></span><span>Built on the .NET 8 game engine</span></div>
    </section>

    <div class="game-layout">
        <section class="board-panel" aria-label="Game board">
            <div class="board-topline">
                <div>
                    <span class="eyebrow">@Session.GameModeLabel</span>
                    <h2>@Session.TurnLabel</h2>
                </div>
                <span class="turn-chip @(Session.Board.Turn == PlayerColor.White ? "white-turn" : "black-turn")">@(Session.Board.Turn == PlayerColor.White ? "♔" : "♚")</span>
            </div>
            <ChessBoard Board="Session.DisplayBoard"
                        Selected="Session.SelectedSquare"
                        LegalTargets="Session.LegalTargets"
                        CanInteract="Session.CanInteract"
                        OnSquareClicked="OnSquareClicked" />
            <div class="board-caption">
                <span class="status-indicator"></span>
                <span>@Session.Message</span>
            </div>
        </section>

        <aside class="control-panel">
            <div class="panel-section">
                <div class="section-heading"><span class="eyebrow">NEW GAME</span><span class="section-number">01</span></div>
                <label class="field-label" for="variant">Variant</label>
                <select id="variant" class="form-control mist-select" @bind="_variant">
                    <option value="FogOfWar">Fog of War</option>
                    <option value="ClassicChess">Classic Chess</option>
                </select>
                <label class="field-label" for="mode">Game mode</label>
                <select id="mode" class="form-control mist-select" @bind="_mode">
                    <option value="Bot">Play against a bot</option>
                    <option value="LocalTwoPlayer">Two players, one screen</option>
                </select>
                @if (_mode == GameMode.Bot)
                {
                    <label class="field-label" for="bot">Opponent</label>
                    <select id="bot" class="form-control mist-select" @bind="_botId">
                        @foreach (var bot in BotProfiles.All)
                        {
                            <option value="@bot.Id">@bot.Name · @bot.Title</option>
                        }
                    </select>
                    <label class="field-label" for="color">Your color</label>
                    <select id="color" class="form-control mist-select" @bind="_humanColor">
                        <option value="White">White</option>
                        <option value="Black">Black</option>
                    </select>
                }
                <button type="button" class="primary-button full-button" @onclick="StartGame">Start game <span>↗</span></button>
            </div>

            <div class="panel-section tools-section">
                <div class="section-heading"><span class="eyebrow">TOOLS</span><span class="section-number">02</span></div>
                <div class="tool-row">
                    <button type="button" class="secondary-button" @onclick="Undo" disabled="@(Session.Board.History.IsEmpty || Session.IsBotThinking)">↶ Undo move</button>
                    <button type="button" class="secondary-button icon-button" @onclick="ToggleReplay" disabled="@(!Session.IsReplayAvailable)">⏱ Replay</button>
                </div>
                @if (Session.ReplayStep is not null)
                {
                    <label class="field-label" for="replay">Move in game · @Session.ReplayStep / @Session.Board.History.Count</label>
                    <input id="replay" class="timeline" type="range" min="0" max="@Session.Board.History.Count" value="@Session.ReplayStep" @oninput="ReplayChanged" />
                    <select class="form-control mist-select" aria-label="Replay perspective" value="@Session.ReplayPerspective" @onchange="ReplayPerspectiveChanged">
                        <option value="WhiteFog">White's view</option>
                        <option value="BlackFog">Black's view</option>
                        <option value="Omniscient">Full board</option>
                    </select>
                    <button type="button" class="text-button" @onclick="CloseReplay">Return to game</button>
                }
            </div>

            <div class="panel-section captured-section">
                <div class="section-heading"><span class="eyebrow">CAPTURED PIECES</span><span class="section-number">03</span></div>
                <div class="captured-line"><span>Captured by White</span><span class="captured-pieces">@CapturedGlyphs(PlayerColor.White)</span></div>
                <div class="captured-line"><span>Captured by Black</span><span class="captured-pieces">@CapturedGlyphs(PlayerColor.Black)</span></div>
            </div>

            <div class="panel-section history-section">
                <div class="section-heading"><span class="eyebrow">MOVE HISTORY</span><span class="section-number">04</span></div>
                <div class="move-list" aria-label="Move history">
                    @if (Session.History.IsEmpty)
                    {
                        <p class="empty-note">Moves will appear here once the game starts.</p>
                    }
                    else
                    {
                        @for (var index = 0; index < Session.History.Count; index++)
                        {
                            var move = Session.History[index];
                            <button type="button" class="move-entry @(Session.ReplayStep == index + 1 ? "move-active" : "")" @onclick="() => Session.SetReplay(index + 1, Session.ReplayPerspective)">
                                <span>@(index / 2 + 1).@(index % 2 == 0 ? "" : " …")</span><strong>@MoveText.Format(move)</strong>
                            </button>
                        }
                    }
                </div>
            </div>
        </aside>
    </div>

    <section class="feature-strip" aria-label="Fog of War features">
        <article><span class="feature-symbol">◉</span><div><h3>King Radar</h3><p>A five-by-five view around your king helps you navigate the fog.</p></div></article>
        <article><span class="feature-symbol">≈</span><div><h3>Acoustic Footsteps</h3><p>A nearby move leaves a sound ripple without revealing the piece.</p></div></article>
        <article><span class="feature-symbol">⟲</span><div><h3>Time-Travel Replay</h3><p>Review the game from either player's perspective or reveal the full board.</p></div></article>
    </section>
</div>

@if (Session.PromotionFrom is not null)
{
    <PromotionDialog OnChoose="ChoosePromotion" OnCancel="CancelPromotion" />
}

@code {
    private GameVariant _variant = GameVariant.FogOfWar;
    private GameMode _mode = GameMode.Bot;
    private string _botId = BotProfiles.MistWalker.Id;
    private PlayerColor _humanColor = PlayerColor.White;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Session.StartNewGame(_variant, _mode, _botId, _humanColor);
    }

    private async Task StartGame()
    {
        Session.StartNewGame(_variant, _mode, _botId, _humanColor);
        await RunBotIfNeeded();
    }

    private async Task OnSquareClicked(Position position)
    {
        Session.ClickSquare(position);
        await RunBotIfNeeded();
    }

    private async Task RunBotIfNeeded()
    {
        if (Session.IsAwaitingBot) await Session.PlayBotTurnAsync();
    }

    private void Undo() => Session.Undo();
    private void ToggleReplay() => Session.SetReplay(Session.ReplayStep is null ? Session.Board.History.Count : null, Session.ReplayPerspective);
    private void CloseReplay() => Session.SetReplay(null, Session.ReplayPerspective);
    private void ReplayChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var step)) Session.SetReplay(step, Session.ReplayPerspective);
    }
    private void ReplayPerspectiveChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<ReplayPerspective>(args.Value?.ToString(), out var perspective)) Session.SetReplay(Session.ReplayStep, perspective);
    }
    private async Task ChoosePromotion(PieceKind kind)
    {
        Session.ChoosePromotion(kind);
        await RunBotIfNeeded();
    }
    private void CancelPromotion() => Session.CancelPromotion();
    private string CapturedGlyphs(PlayerColor color) => string.Concat(Session.CapturedBy(color).Select(capture => Glyph(capture.Piece.Kind)));
    private static string Glyph(PieceKind kind) => kind switch { PieceKind.King => "♚", PieceKind.Queen => "♛", PieceKind.Rook => "♜", PieceKind.Bishop => "♝", PieceKind.Knight => "♞", _ => "♟" };
    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Session.Changed -= OnSessionChanged;
}
